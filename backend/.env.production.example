# ============================================================
# 生产环境配置模板（复制为 backend/.env 后按注释填写）
#   cp backend/.env.production.example backend/.env
# ⚠️ 本文件只是模板，不要填入真实密钥后提交到 Git。
#    deploy/deploy.sh 会自动生成一份带随机密钥的 .env。
# ============================================================

# 必须设为 prod：启用生产配置自检（见 /api/health 的 config_warnings）
ENV=prod

# ===== 数据库 =====
# 公网环境请用独立账号 + 强密码，不要让应用用 root 连库
DB_URL=mysql+pymysql://ca_app:换成强密码@127.0.0.1:3306/code_adventurer?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0

# ===== JWT =====
# 生成：openssl rand -hex 32
# ⚠️ 用默认值等于把「伪造任意用户登录态」的能力公开
SECRET_KEY=请替换为32位以上随机串
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===== 跨域 =====
# 前后端同域部署（Nginx 反代）时无需跨域，填自己的站点地址即可，别用 *
CORS_ORIGINS=https://your-domain.com

# ===== 登录策略 =====
# 公网必须 false：否则任何人打开网页都是同一个账号，进度互相覆盖
ALLOW_GUEST_LOGIN=false

# ===== AI（留空 = 离线演示模式，零成本）=====
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=deepseek-v4-flash-0731
AI_TIMEOUT=30

# ===== 代码沙箱 =====
# 担心沙箱逃逸就设 false，只关闭「自由运行代码」入口（课程判定不受影响）
CODE_RUN_ENABLED=true
CODE_RUN_TIMEOUT=5
CODE_MAX_MEMORY_MB=512
CODE_MAX_OUTPUT=20000

# ===== 限流 =====
CODE_RUN_PER_MINUTE=12
AI_CALL_PER_MINUTE=15
