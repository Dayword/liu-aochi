# ===== 服务配置 =====
# 数据库连接（默认 MySQL，可切换 SQLite 便于本地快速体验）
# 示例：DB_URL=mysql+pymysql://root:root@127.0.0.1:3306/code_adventurer
DB_URL=mysql+pymysql://root:root@127.0.0.1:3306/code_adventurer?charset=utf8mb4

# Redis 连接（排行榜/会话缓存，不可用时自动降级为数据库计算）
REDIS_URL=redis://127.0.0.1:6379/0

# JWT
SECRET_KEY=code-adventurer-dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===== AI 配置 =====
# 留空则进入「离线演示模式」：使用内置规则引擎 + 种子知识库，全部功能可跑通
# 填入后即接入真实大模型（OpenAI 兼容协议，可对接豆包/DeepSeek/通义千问等）
# 豆包示例：AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3  AI_API_KEY=你的Key  AI_MODEL=ep-xxxx
# DeepSeek 示例：AI_BASE_URL=https://api.deepseek.com  AI_API_KEY=sk-xxx  AI_MODEL=deepseek-chat
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=30

# 代码运行（本地演示沙箱，仅支持 Python；生产环境应替换为 Judge0/Docker 沙箱）
CODE_RUN_TIMEOUT=5
