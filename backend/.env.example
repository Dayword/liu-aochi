# ===== 服务配置 =====
# dev = 本地开发；prod = 公网部署（触发配置安全自检，见 /api/health）
ENV=dev

# 数据库连接（默认 MySQL，可切换 SQLite 便于本地快速体验）
# 示例：DB_URL=mysql+pymysql://root:root@127.0.0.1:3306/code_adventurer
DB_URL=mysql+pymysql://root:root@127.0.0.1:3306/code_adventurer?charset=utf8mb4

# Redis 连接（排行榜/会话缓存，不可用时自动降级为数据库计算）
REDIS_URL=redis://127.0.0.1:6379/0

# JWT（生产环境必须换成随机串：openssl rand -hex 32）
SECRET_KEY=code-adventurer-dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 允许跨域的前端来源，逗号分隔。本地开发用 *，生产必须写实际域名
CORS_ORIGINS=*

# 直通登录（免账号直接进入主账号）。本地开发 true 方便；
# ⚠️ 公网部署必须 false，否则所有人共享同一个账号、进度互相覆盖
ALLOW_GUEST_LOGIN=true
AUTO_LOGIN_USERNAME=如梦令

# ===== AI 配置 =====
# 留空则进入「离线演示模式」：使用内置规则引擎 + 种子知识库，全部功能可跑通
# 填入后即接入真实大模型（OpenAI 兼容协议，可对接豆包/DeepSeek/通义千问等）
# 豆包示例：AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3  AI_API_KEY=你的Key  AI_MODEL=ep-xxxx
# DeepSeek 示例：AI_BASE_URL=https://api.deepseek.com  AI_API_KEY=sk-xxx  AI_MODEL=deepseek-chat
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=30

# 代码运行（沙箱：AST 模块白名单 + 资源限制 + 限流；生产可置换为 Judge0/Docker）
CODE_RUN_ENABLED=true
CODE_RUN_TIMEOUT=5
CODE_MAX_MEMORY_MB=512
CODE_MAX_OUTPUT=20000

# 限流（次/分钟，按用户；未登录按 IP）
CODE_RUN_PER_MINUTE=12
AI_CALL_PER_MINUTE=15
